# Builder image for release .deb files.
#
# Ubuntu 22.04 on purpose: it is the oldest release PingInfoManager supports, and
# a cgo binary can only run against a glibc at least as new as the one it was
# linked against. Built on 24.04 (glibc 2.39) the binary picks up glibc 2.38's
# C23 redirects — __isoc23_sscanf, __isoc23_strtol, __isoc23_strtoul — which do
# not exist in 22.04's glibc 2.35. dpkg installs such a package without
# complaint and the binary then refuses to start, with
# "libc.so.6: version `GLIBC_2.38' not found". That is exactly the bug this
# image exists to prevent. Linking against 2.35 is forward compatible, so one
# .deb covers 22.04, 24.04 and later.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# gcc + libc6-dev for cgo, then the same GL/X11/Wayland headers the README tells
# a developer to install. glfw needs the Wayland and xkbcommon headers even
# though it opens the X11 libraries with dlopen at runtime.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      gcc \
      libc6-dev \
      libgl1-mesa-dev \
      xorg-dev \
      libwayland-dev \
      libxkbcommon-dev \
 && rm -rf /var/lib/apt/lists/*

# Go comes from the upstream tarball rather than from apt, because 22.04 only
# ships Go 1.18 and go.mod needs 1.22. build-deb.sh passes the host's own Go
# version, so a container build and a --local build always use the same
# toolchain; the download is a cached image layer, repeated only when that
# version changes.
#
# Not the host's GOROOT bind-mounted, which was the obvious alternative and does
# not work: Debian/Ubuntu's golang packages symlink src/, api/, misc/ and test/
# out to /usr/share/go-<ver>/, so a mount of /usr/lib/go-<ver> alone arrives
# with a dangling src/ and every build fails with "package unicode is not in
# std".
ARG GO_VERSION
ARG GO_ARCH=amd64
RUN test -n "$GO_VERSION" || { echo "GO_VERSION build-arg is required" >&2; exit 1; } \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" \
      -o /tmp/go.tar.gz \
 && tar -C /usr/local -xzf /tmp/go.tar.gz \
 && rm /tmp/go.tar.gz \
 && /usr/local/go/bin/go version

ENV PATH=/usr/local/go/bin:$PATH
